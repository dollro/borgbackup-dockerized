# S3 Configuration for BorgBackup
# Copy this file to .env and fill in your actual values

# S3 Bucket Configuration
S3_BUCKET_NAME=your-borgbackup-bucket-name

# AWS Credentials
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS Region (optional, defaults to us-east-1)
AWS_DEFAULT_REGION=eu-central-1

# Logging Configuration (optional, defaults to INFO)
# Set to DEBUG for verbose output and troubleshooting
# Set to INFO for minimal, production-ready output
LOGGING=INFO

# Borg Backup Configuration
BORG_REPO=/mnt/backup/borgbackup
BORG_PASSPHRASE='abcdefghijk123456789'