# BorgBackup Storage Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# STORAGE BACKEND SELECTION
# =============================================================================
# Choose your backup storage destination
# Options: "s3" | "usb" | "local"
BACKUP_STORAGE_TYPE=s3

# =============================================================================
# COMMON CONFIGURATION (Required for all backends)
# =============================================================================

# Borg Backup Configuration
BORG_REPO=/mnt/backup/borgbackup
BORG_PASSPHRASE='your-secure-passphrase-here'

# Logging Configuration (optional, defaults to INFO)
# Set to DEBUG for verbose output and troubleshooting
# Set to INFO for minimal, production-ready output
LOGGING=INFO

# =============================================================================
# S3 BACKEND CONFIGURATION (when BACKUP_STORAGE_TYPE=s3)
# =============================================================================

# S3 Bucket Configuration
S3_BUCKET_NAME=your-borgbackup-bucket-name

# AWS Credentials
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS Region (optional, defaults to us-east-1)
AWS_DEFAULT_REGION=eu-central-1

# =============================================================================
# USB BACKEND CONFIGURATION (when BACKUP_STORAGE_TYPE=usb)
# =============================================================================
# 
# To use USB storage:
# 1. Connect your USB drive
# 2. Find the UUID: sudo blkid
#    Example output: /dev/sdb1: UUID="1234-5678" TYPE="ext4"
# 3. Set USB_DEVICE_UUID to the UUID value
#
# Supported filesystems: ext4, ext3, ext2, xfs, btrfs, ntfs, vfat

USB_DEVICE_UUID=

# =============================================================================
# LOCAL BACKEND CONFIGURATION (when BACKUP_STORAGE_TYPE=local)
# =============================================================================
#
# For local storage (NAS, network share, or any mounted path on host):
# 1. Set LOCAL_BACKUP_PATH to an existing directory on your host
# 2. Use the borgbackup-local service: docker compose --profile local run borgbackup-local
#
# Examples:
#   LOCAL_BACKUP_PATH=/mnt/nas/backups
#   LOCAL_BACKUP_PATH=/media/backup-drive
#   LOCAL_BACKUP_PATH=/home/user/backups

LOCAL_BACKUP_PATH=

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================
#
# --- Example 1: S3 Backend (Default) ---
# BACKUP_STORAGE_TYPE=s3
# S3_BUCKET_NAME=myserver-backup
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_DEFAULT_REGION=eu-central-1
#
# --- Example 2: USB Backend ---
# BACKUP_STORAGE_TYPE=usb
# USB_DEVICE_UUID=1234-5678-90AB-CDEF
#
# --- Example 3: Local/NAS Backend ---
# BACKUP_STORAGE_TYPE=local
# LOCAL_BACKUP_PATH=/mnt/nas/backups
#
# =============================================================================
